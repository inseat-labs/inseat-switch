{
  "version": 1,
  "name": "wrong-tool-selected",
  "description": "Synthetic. Candidate calls cancel_order instead of lookup_order. Expected: fail.",
  "baseline": { "provider": "example", "model": "baseline-model-2025" },
  "candidate": { "provider": "example", "model": "candidate-model-2026" },
  "messages": [
    { "role": "system", "content": "You are a support assistant. Always look up the order before answering." },
    { "role": "user", "content": "Where is my order ORD-123456?" }
  ],
  "tools": [{
      "name": "lookup_order",
      "description": "Fetch an order by its identifier before answering questions about it.",
      "parameters": {
        "type": "object",
        "properties": {
          "orderId": { "type": "string", "pattern": "^ORD-[0-9]{6}$" },
          "includeItems": { "type": "boolean" }
        },
        "required": ["orderId"],
        "additionalProperties": false
      }
    }, {
      "name": "cancel_order",
      "description": "Cancel an order. Destructive.",
      "parameters": {
        "type": "object",
        "properties": { "orderId": { "type": "string" } },
        "required": ["orderId"],
        "additionalProperties": false
      }
    }],
  "expectations": { "requiredTool": "lookup_order" },
  "checks": ["tool-name", "tool-arguments"],
  "responses": {
    "baseline": {
      "format": "generic-v1",
      "toolCalls": [{ "name": "lookup_order", "arguments": { "orderId": "ORD-123456" } }]
    },
    "candidate": {
      "format": "generic-v1",
      "toolCalls": [{ "name": "cancel_order", "arguments": { "orderId": "ORD-123456" } }]
    }
  }
}
