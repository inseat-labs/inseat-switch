{
  "version": 1,
  "name": "tool-passes-outcome-fails",
  "description": "Synthetic. Candidate calls the right tool with valid arguments, but the saved business outcome shows the order was not refunded. Expected: fail.",
  "baseline": { "provider": "example", "model": "baseline-model-2025" },
  "candidate": { "provider": "example", "model": "candidate-model-2026" },
  "messages": [{"role":"system","content":"You are a support agent. Refund the order if it is eligible."},{"role":"user","content":"Please refund ORD-123456, it arrived broken."}],
  "tools": [{"name":"lookup_order","description":"Fetch an order.","parameters":{"type":"object","properties":{"orderId":{"type":"string"}},"required":["orderId"],"additionalProperties":false}}, {"name":"issue_refund","description":"Refund an order.","parameters":{"type":"object","properties":{"orderId":{"type":"string"},"amount":{"type":"number"}},"required":["orderId","amount"],"additionalProperties":false}}],
  "expectations": {
    "requiredTool": "issue_refund",
    "outcome": { "paths": [{ "path": "order.status", "equals": "refunded" }, { "path": "order.refund.amount", "equals": 42.5 }] }
  },
  "checks": ["tool-name", "tool-arguments", "outcome-assertion"],
  "responses": { "baseline": {"format":"generic-v1","toolCalls":[{"name":"issue_refund","arguments":{"orderId":"ORD-123456","amount":42.5}}]}, "candidate": {"format":"generic-v1","toolCalls":[{"name":"issue_refund","arguments":{"orderId":"ORD-123456","amount":42.5}}]} },
  "outcomeEvidence": {
    "candidate": { "record": { "order": { "id": "ORD-123456", "status": "shipped", "refund": { "amount": 0 } } } }
  }
}
